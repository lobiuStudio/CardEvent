{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:cloudflare-guard": "node --test scripts/guard-cloudflare-deploy-env.test.mjs",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "build:cloudflare": "DATABASE_PROVIDER=d1 NODE_OPTIONS=--max-old-space-size=4096 opennextjs-cloudflare build && npm run check:cloudflare-bundle",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "check:cloudflare-deploy-env": "node scripts/guard-cloudflare-deploy-env.mjs",
    "check:cloudflare-bundle": "node scripts/check-cloudflare-bundle.mjs",
    "deploy:cloudflare": "npm run check:cloudflare-deploy-env && npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload:cloudflare": "npm run check:cloudflare-deploy-env && npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf:typegen": "mkdir -p .wrangler/types && wrangler types --env-interface CloudflareEnv .wrangler/types/cloudflare-env.d.ts",
    "d1:migration:init": "mkdir -p prisma/migrations && prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > prisma/migrations/0001_init.sql",
    "d1:apply:local": "wrangler d1 execute cardevent-db --local --file ./prisma/migrations/0001_init.sql",
    "d1:apply:remote": "wrangler d1 execute cardevent-db --remote --file ./prisma/migrations/0001_init.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "csv-stringify": "^6.7.0",
    "file-type": "^22.0.1",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "marked": "^18.0.5",
    "next": "16.2.7",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260607.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
